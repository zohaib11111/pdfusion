# ==========================================
# APPWRITE CONFIGURATION
# ==========================================

# Frontend Configuration (Client-side) - VITE_ prefix required for Vite
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
VITE_APPWRITE_PROJECT_NAME=YOUR_PROJECT_NAME

# Database Configuration
VITE_APPWRITE_DATABASE_ID=YOUR_DATABASE_ID

# Storage Configuration
VITE_APPWRITE_STORAGE_BUCKET_ID=pdf-files

# ==========================================
# SERVER-SIDE CONFIGURATION (for setup scripts)
# ==========================================

# API Key for server-side operations (database setup, backend functions)
# This is DIFFERENT from the dev key used in client-side code
APPWRITE_API_KEY=YOUR_SERVER_API_KEY

# ==========================================
# GOOGLE VISION API (for backend functions)
# ==========================================
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_VISION_API_KEY

# ==========================================
# SETUP INSTRUCTIONS:
# ==========================================
#
# 1. Create Appwrite project at https://cloud.appwrite.io
# 2. Copy your Project ID from the project dashboard
# 3. Create a database and copy the Database ID
# 4. Create a storage bucket named 'pdf-files'
#
# 5. CREATE API KEY (for server-side operations):
#    - Go to your project dashboard
#    - Navigate to "API Keys" in the left sidebar
#    - Click "Create API Key"
#    - Name: "PDFusion Server Key"
#    - Scopes: Select ALL scopes (or at minimum):
#      * databases.read
#      * databases.write
#      * storage.read
#      * storage.write
#      * functions.read
#      * functions.write
#    - Copy the generated API key (it starts with a number like "919c2d18fb...")
#
# 6. Run the database setup script: npm run setup-db
#
# ==========================================
# EXAMPLE CONFIGURATION:
# ==========================================
# VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# VITE_APPWRITE_PROJECT_ID=64f1a2b3c4d5e6f7g8h9i0j1
# VITE_APPWRITE_DATABASE_ID=64f1a2b3c4d5e6f7g8h9i0j2
# VITE_APPWRITE_STORAGE_BUCKET_ID=pdf-files
# APPWRITE_API_KEY=919c2d18fb5d4...a2ae413da83346ad2
# GOOGLE_VISION_API_KEY=AIzaSyB...
